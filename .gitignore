# Ignore everything by default
/*

# VS Code workspace file
*.code-workspace

# Python cache
**/__pycache__
**/*.pyc

# Only track these folders
!/Plugins/PythonLib
!/Tools/
/Tools/*
!/Tools/Python

# Ignore Binaries and Intermediate inside Plugins
/Plugins/**/Binaries
/Plugins/**/Intermediate

# Ignore all subfolders of Tools/Python except MayaScripts and UnrealScripts
/Tools/Python/*/
!/Tools/Python/MayaScripts/
!/Tools/Python/UnrealScripts/
